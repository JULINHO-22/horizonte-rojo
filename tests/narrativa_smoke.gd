extends SceneTree
## Ejecutar con perfil temporal para no tocar la partida del jugador.
func _initialize() -> void:
	call_deferred("_probar")

func _captura(nombre: String) -> void:
	if DisplayServer.get_name() == "headless":
		return
	await process_frame
	await RenderingServer.frame_post_draw
	DirAccess.make_dir_recursive_absolute("res://build/qa")
	root.get_texture().get_image().save_png("res://build/qa/" + nombre + ".png")

func _tramo(puesto: PuestoUmbra, origen: Vector2, destino: Vector2) -> void:
	for i in range(int(origen.distance_to(destino)) + 1):
		var punto := origen.move_toward(destino, float(i))
		assert(puesto.transitable(punto), "Ruta bloqueada en %s" % punto)

func _probar() -> void:
	var juego = load("res://scenes/umbra.tscn").instantiate()
	root.add_child(juego)
	juego.set_process(false)
	await _captura("portada")
	juego._reiniciar()
	assert(juego.fase == "ida")
	assert(juego.viaje.get_child_count() == 6, "El viaje debe usar tres fondos, estela, transferencia y módulo")
	assert(juego.viaje.fondo_salida is TextureRect and juego.viaje.fondo_salida.texture.resource_path == "res://assets/NarrativaInicio/TierraPixelArt.png")
	assert(juego.viaje.fondo_espacio is TextureRect and juego.viaje.fondo_espacio.texture.resource_path == "res://assets/NarrativaInicio/EspacioProfundoPixelArt.png")
	assert(juego.viaje.fondo_llegada is TextureRect and juego.viaje.fondo_llegada.texture.resource_path == "res://assets/NarrativaInicio/MartePixelArt.png")
	assert(juego.viaje.estela.texture.resource_path == "res://assets/NarrativaInicio/EstelaPropulsionPixelArt.png")
	assert(juego.viaje.transferencia.texture.resource_path == "res://assets/NarrativaInicio/NaveTransferenciaPixelArt.png")
	assert(juego.viaje.modulo.texture.resource_path == "res://assets/NarrativaInicio/ModuloDescensoOrbitalPixelArt.png")
	juego._process(1.4)
	await _captura("trayectoria")
	juego._process(2.2)
	assert(juego.viaje.transferencia.modulate.a > 0.8 and juego.viaje.modulo.modulate.a > 0.8)
	await _captura("separacion")
	juego._process(1.65)
	assert(juego.viaje.transferencia.modulate.a < 0.1 and juego.viaje.modulo.modulate.a > 0.95)
	await _captura("aproximacion-marte")
	juego._process(0.16)
	assert(juego.fase == "aterrizaje")
	juego._process(1.0)
	await _captura("descenso")
	juego._process(1.61)
	assert(juego.fase == "camino_base")
	await _captura("percy")
	juego.puesto.punto = PuestoUmbra.ESCLUSA
	juego._process(0.02)
	assert(juego.fase == "esclusa")
	juego._process(3.6)
	assert(juego.fase == "base")
	var mapa: PuestoUmbra = juego.puesto
	assert(not mapa.transitable(Vector2(402, 225)), "La supercomputadora ocupa el centro")
	assert(mapa.transitable(PuestoUmbra.TERMINALES.radio), "La terminal debe quedar delante del equipo")
	_tramo(mapa, Vector2(402, 394), Vector2(402, 245))
	_tramo(mapa, Vector2(402, 245), Vector2(191, 245))
	_tramo(mapa, Vector2(191, 245), Vector2(191, 42))
	_tramo(mapa, Vector2(191, 42), Vector2(25, 42))
	_tramo(mapa, Vector2(25, 42), PuestoUmbra.EQUIPO_AGUA[0])
	_tramo(mapa, PuestoUmbra.EQUIPO_AGUA[0], PuestoUmbra.ESTACION_OXIGENO)
	for prueba in [[PuestoUmbra.EQUIPO_AGUA[0], "agua"], [PuestoUmbra.ESTACION_OXIGENO, "oxigeno"]]:
		juego.posicion = prueba[0]
		juego._mostrar()
		juego._accion()
		assert(juego.estacion == prueba[1])
		juego._cerrar_estacion()
	await _captura("laboratorio-agua-oxigeno")
	mapa = juego.puesto
	_tramo(mapa, Vector2(402, 245), Vector2(716, 245))
	_tramo(mapa, Vector2(538, 245), Vector2(538, 133))
	_tramo(mapa, Vector2(538, 133), Vector2(681, 133))
	_tramo(mapa, Vector2(681, 133), Vector2(681, 89))
	_tramo(mapa, Vector2(538, 133), Vector2(404, 133))
	_tramo(mapa, Vector2(404, 133), Vector2(404, 97))
	assert(not mapa.transitable(Vector2(1000, 160)))
	assert(not mapa.transitable(Vector2(100, 190)))
	juego.posicion = Vector2(402, 270)
	juego._mostrar()
	await _captura("control-supercomputadora")
	juego.posicion = PuestoUmbra.TERMINALES.radio
	juego._mostrar()
	juego._accion()
	assert(is_instance_valid(juego.panel_control))
	await create_timer(0.19).timeout
	await _captura("campana-panel-control")
	juego._cerrar_control()
	_tramo(juego.puesto, Vector2(402, 360), PuestoUmbra.ACCESO_NUCLEO)
	juego.posicion = PuestoUmbra.ACCESO_NUCLEO
	juego._mostrar()
	juego._accion()
	assert(is_instance_valid(juego.visita_nucleo) and juego.visita_nucleo.zona == "refugio")
	await _captura("campana-nucleo-protegido")
	juego._accion()
	assert(juego.visita_nucleo == null and juego.fase == "base" and juego.posicion == PuestoUmbra.ACCESO_NUCLEO)
	juego.posicion = Vector2(402, 329)
	juego._mostrar()
	await _captura("umbral")
	juego.puesto.plano = true
	juego.puesto.actualizar_camara(3)
	juego.puesto.queue_redraw()
	await _captura("plano")
	for dia in range(1, 6):
		assert(juego.campana.sol == dia)
		assert(juego.recursos.aplicar_decision("insumos_de_prueba", {"energia": 12, "agua": 6}))
		assert(juego.recursos.activar_oxigeno())
		juego.posicion = PuestoUmbra.TERMINALES.dormitorio
		juego._mostrar()
		juego._accion()
		assert(juego.fase == "noche")
		juego._process(1.5)
		assert(is_equal_approx(juego.velo.color.a, 0.5))
		if dia == 1: await _captura("noche")
		juego._process(1.51)
		assert(juego.fase == "amanecer")
		assert(juego.campana.noches == dia)
		var guardado = load("res://scripts/campana_narrativa.gd").new()
		assert(guardado.cargar().fase == "base" and guardado.noches == dia)
		juego._process(1.6)
		assert(juego.fase == "base")
	assert(juego.campana.sol == 5 and juego.campana.listo_para_regresar())
	juego._accion()
	assert(juego.fase == "base", "No debe existir una sexta noche")
	juego.posicion = PuestoUmbra.TERMINALES.radio
	juego._mostrar()
	juego._accion()
	assert(is_instance_valid(juego.panel_control))
	juego.panel_control.ruta_confirmada.emit()
	assert(juego.puesto.objetivo_mision == "cierre")
	juego.posicion = PuestoUmbra.TERMINALES.cierre
	juego._mostrar()
	juego._accion()
	assert(juego.fase == "camino_nave")
	juego._accion()
	assert(juego.fase == "camino_nave", "No se puede embarcar lejos de la nave")
	juego.posicion = Vector2(220, PuestoUmbra.SUELO)
	juego._accion()
	assert(juego.fase == "pilotaje")
	juego._accion()
	assert(juego.fase == "despegue")
	juego._process(6.1)
	assert(juego.fase == "regreso")
	juego.viaje.progreso = 0.55
	assert(not juego.viaje.transferencia.visible and not juego.viaje.estela.visible,
		"La cápsula regresa sin recuperar la etapa de transferencia")
	juego._process(9.1)
	juego._process(1.1)
	assert(juego.fase == "epilogo")
	juego._process(10.1)
	assert(juego.boton.visible)
	await _captura("epilogo")
	print("NARRATIVA_OK: rutas, ida, esclusa, cinco noches, guardado y regreso verificados.")
	quit()
